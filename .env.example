# =============================================================================
#  .env.example — File mẫu cấu hình môi trường
#  Sao chép file này thành ".env" và điền các giá trị thực vào.
#  File ".env" đã được gitignore — KHÔNG BAO GIỜ commit ".env" thật lên Git!
# =============================================================================

# --- SECURITY CONFIGURATION ---
# Tạo bằng lệnh: openssl rand -base64 64
# Tối thiểu 32 ký tự, càng phức tạp càng tốt.
JWT_SECRET=REPLACE_ME_generate_with_openssl_rand_-base64_64

# Tạo bằng lệnh: openssl rand -base64 48
PUBLIC_ID_SECRET=REPLACE_ME_generate_with_openssl_rand_-base64_48

# --- WEB PUSH (VAPID) CONFIGURATION ---
# Email liên hệ cho dịch vụ Push (Bắt buộc theo spec VAPID)
VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- GOOGLE GEMINI AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# Key VAPID (Để trống nếu muốn hệ thống tự động sinh ra và lưu vào DB)
# VAPID_PUBLIC_KEY=your_public_key
# VAPID_PRIVATE_KEY=your_private_key

# --- NGROK CONFIGURATION ---
# Lấy token mới tại: https://dashboard.ngrok.com/tunnels/authtokens
NGROK_AUTHTOKEN=your_new_ngrok_authtoken_here
# Domain cố định (nếu có, ví dụ: my-app.ngrok-free.app). Để trống nếu không dùng.
NGROK_DOMAIN=

# --- RABBITMQ CONFIGURATION ---
# Không dùng "guest/guest" trong production!
RABBITMQ_USER=your_rabbitmq_username
RABBITMQ_PASS=your_strong_rabbitmq_password

# --- SYSTEM CONFIGURATION ---
# Môi trường chạy (Production/Development)
ASPNETCORE_ENVIRONMENT=Production

# Múi giờ hệ thống
TZ=Asia/Ho_Chi_Minh

# Đường dẫn DB trong container
DB_PATH=/app/data/documents.db
TAVILY_API_KEY=your_tavily_key_here

# Python AI Service URL (Docker internal DNS)
PythonAiServiceUrl=http://python-ai-service:8001
