# --- SECURITY CONFIGURATION ---
# Chuỗi ký tự bí mật để mã hóa Token (Tối thiểu 32 ký tự)
JWT_SECRET=LinkStrategy_Secure_Key_2026_ReplaceMe_With_Long_Random_String

# --- WEB PUSH (VAPID) CONFIGURATION ---
# Email liên hệ cho dịch vụ Push (Bắt buộc theo spec VAPID)
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Key VAPID (Để trống nếu muốn hệ thống tự động sinh ra và lưu vào DB)
# VAPID_PUBLIC_KEY=your_public_key
# VAPID_PRIVATE_KEY=your_private_key

# --- NGROK CONFIGURATION ---
# Lấy token tại: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# Domain cố định (nếu có, ví dụ: my-app.ngrok-free.app)
NGROK_DOMAIN=your_domain_here.ngrok-free.app

# --- SYSTEM CONFIGURATION ---
# Môi trường chạy (Production/Development)
ASPNETCORE_ENVIRONMENT=Production

# Múi giờ hệ thống
TZ=Asia/Ho_Chi_Minh

# Đường dẫn DB trong container (Mặc định: /app/data/documents.db)
DB_PATH=/app/data/documents.db
