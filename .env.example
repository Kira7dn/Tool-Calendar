# --- NGROK CONFIGURATION ---
# Lấy token tại: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# Domain cố định (nếu có, ví dụ: my-app.ngrok-free.app)
NGROK_DOMAIN=your_domain_here.ngrok-free.app

# --- SYSTEM CONFIGURATION ---
# Môi trường chạy (Production/Development)
ASPNETCORE_ENVIRONMENT=Production

# Đường dẫn DB trong container (Mặc định: /app/data/documents.db)
# DB_PATH=/app/data/documents.db
