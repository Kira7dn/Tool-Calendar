<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập | Hệ Thống Điều Phối Công Văn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <style>
      body.login-page {
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(145deg, #1a3a6e 0%, #0f2654 60%, #922b21 100%);
        overflow: hidden;
      }

      body.login-page::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 6px;
        background: linear-gradient(to right, #c0392b 33%, #f1c40f 33%, #f1c40f 66%, #c0392b 66%);
        z-index: 10;
      }

      .login-card {
        width: 420px;
        padding: 44px 40px 36px;
        background: #ffffff;
        border-radius: 14px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        border-top: 5px solid #c0392b;
      }

      .login-logo {
        width: 72px;
        height: 72px;
        margin-bottom: 16px;
        border-radius: 8px;
        border: 3px solid #1a3a6e;
      }

      .login-card h2 {
        font-size: 1.45rem;
        font-weight: 800;
        margin-bottom: 4px;
        color: #1a3a6e;
      }

      .login-card > p {
        color: #4a5568;
        font-size: 0.9rem;
        margin-bottom: 28px;
      }

      .form-group {
        text-align: left;
        margin-bottom: 18px;
      }

      .form-group label {
        display: block;
        font-size: 0.82rem;
        color: #374151;
        margin-bottom: 6px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
      }

      .form-group input {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 16px;
        background: #f8faff;
        border: 1.5px solid #c9d4e8;
        border-radius: 8px;
        color: #1a1a2e;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        font-size: 1rem;
        font-family: inherit;
      }

      .form-group input:focus {
        border-color: #1a3a6e;
        box-shadow: 0 0 0 3px rgba(26, 58, 110, 0.1);
        background: #fff;
      }

      .login-btn {
        width: 100%;
        margin-top: 8px;
        justify-content: center;
        padding: 13px;
        font-size: 1rem;
        background: #c0392b;
        border-radius: 8px;
        color: white;
      }

      .login-btn:hover {
        background: #a93226;
      }

      .error-msg {
        color: #c0392b;
        font-size: 0.85rem;
        margin-top: 14px;
        background: #fdf2f2;
        border: 1px solid #f5c6cb;
        padding: 10px 14px;
        border-radius: 7px;
        text-align: left;
      }
    </style>
    <script type="module" crossorigin src="/vite-assets/login-CNbH8to5.js"></script>
    <link rel="modulepreload" crossorigin href="/vite-assets/globals-Ba8sIEuH.js">
    <link rel="stylesheet" crossorigin href="/vite-assets/globals-8Q_kjERE.css">
  </head>
  <body class="login-page">
    <div id="root"></div>
  </body>
</html>
